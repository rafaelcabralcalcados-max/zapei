        "authorizedByDeviceId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "deviceId", "deviceName", "platform", "primary", "createdAt", "lastActiveAt"]
    },
    "DeviceAuthRequest": {
      "title": "DeviceAuthRequest",
      "description": "Real-time authorization request for linking a new device via QR Code or 6-digit code.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requestToken": { "type": "string", "minLength": 16, "maxLength": 128 },
        "code6": { "type": "string", "minLength": 6, "maxLength": 6 },
        "deviceId": { "type": "string", "minLength": 6, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "deviceName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 60 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "expired"] },
        "approvedByDeviceId": { "type": "string", "maxLength": 128 },
        "expiresAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "requestToken", "code6", "deviceId", "deviceName", "platform", "status", "expiresAtMs", "createdAt", "updatedAt"]
    },
    "PushEndpointBlob": {
      "title": "PushEndpointBlob",
      "description": "AES-256-GCM encrypted Web Push subscriptions persisted per user so background call and message notifications survive server restarts.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
