        "authTag": { "type": "string", "minLength": 16, "maxLength": 64 },
        "deviceCount": { "type": "number" },
        "updatedAtMs": { "type": "number" }
      },
      "required": ["ownerId", "ciphertext", "iv", "authTag", "deviceCount", "updatedAtMs"]
    },
