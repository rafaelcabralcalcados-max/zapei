      "required": ["callerId", "callerName", "calleeId", "calleeName", "callType", "status", "createdAt", "updatedAt"]
    },
    "IceCandidate": {
      "title": "IceCandidate",
      "description": "WebRTC ICE candidate for peer connection negotiation.",
      "type": "object",
      "properties": {
