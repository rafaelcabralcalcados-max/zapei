        "phoneHash": { "type": "string", "maxLength": 128 },
        "virtualLineHash": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["active", "lifted"] },
        "reason": { "type": "string", "minLength": 3, "maxLength": 240 },
        "reportId": { "type": "string", "maxLength": 128 },
        "ticketId": { "type": "string", "maxLength": 128 },
        "orderCode": { "type": "string", "maxLength": 32 },
        "bannedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
