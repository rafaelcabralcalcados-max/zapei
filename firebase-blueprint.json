        "liftedAtMs": { "type": "number" },
        "liftedByUid": { "type": "string", "maxLength": 128 },
        "liftNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["banKey", "identifierType", "targetUid", "targetName", "status", "reason", "bannedByUid", "bannedAtMs", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public profile and storefront metadata per user."
    },
    "/users/{userId}/private/{privateId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Owner-only PII including raw phone number or virtual line, recovery email, and favorite grades."
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/UserContact" },
      "description": "Owner-only real phonebook contacts imported from device or saved manually."
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/UserDevice" },
      "description": "Owner-only list of authorized devices (primary and linked secondary sessions)."
    },
    "/cpf_registry/{cpfHash}": {
      "schema": { "$ref": "#/entities/CpfRegistry" },
      "description": "SHA-256 CPF registry enforcing strictly one Virtual Line per CPF."
    },
    "/auth_requests/{requestId}": {
      "schema": { "$ref": "#/entities/DeviceAuthRequest" },
      "description": "Pending and resolved real-time device linking requests via QR code or 6-digit code."
    },
    "/push_endpoints/{userId}": {
      "schema": { "$ref": "#/entities/PushEndpointBlob" },
      "description": "AES-256-GCM encrypted W3C Web Push device subscriptions for closed-app and lock-screen delivery."
    },
    "/phone_index/{phoneHash}": {
      "schema": { "$ref": "#/entities/PhoneIndex" },
      "description": "Hashed phone or virtual line lookup documents for real-time Zapei contact discovery."
    },
    "/public_directory/{userId}": {
      "schema": { "$ref": "#/entities/PublicDirectoryEntry" },
      "description": "PII-free public directory for searching Zapei users by name, storefront, or Virtual Line."
    },
    "/connections/{connectionId}": {
      "schema": { "$ref": "#/entities/Connection" },
      "description": "Real reseller-to-manufacturer partnerships."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Real manufacturer products."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Real mixed customer orders."
    },
    "/sub_orders/{subOrderId}": {
      "schema": { "$ref": "#/entities/SubOrder" },
      "description": "Real split manufacturer sub-orders."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Real dual financial layer records."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Real 1-to-1 conversations."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Real messages inside conversations."
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallSession" },
      "description": "Real WebRTC voice and video call sessions and history."
    },
    "/calls/{callId}/callerCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/IceCandidate" },
      "description": "WebRTC ICE candidates sent by the caller."
    },
    "/calls/{callId}/calleeCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/IceCandidate" },
      "description": "WebRTC ICE candidates sent by the callee."
    },
    "/support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "In-app help and support tickets submitted by ChatFi users."
    },
    "/cpf_commercial_links/{cpfHash}": {
      "schema": { "$ref": "#/entities/CpfCommercialLink" },
      "description": "SHA-256 CPF binding preventing multi-account commercial role evasion."
    },
    "/commercial_identity_hashes/{userId}": {
      "schema": { "$ref": "#/entities/CommercialIdentityHashes" },
      "description": "Non-PII SHA-256 identity hashes for cross-identifier commercial compliance."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/CommercialReview" },
      "description": "Star ratings and comments submitted for Manufacturers and Resellers after dispatch/completion."
    },
    "/delivery_reports/{reportId}": {
      "schema": { "$ref": "#/entities/DeliveryReport" },
      "description": "Bad-faith delivery occurrence reports linked to orders and support tickets."
    },
    "/commercial_bans/{banKey}": {
      "schema": { "$ref": "#/entities/CommercialBan" },
      "description": "Exclusive commercial role bans indexed by UID, CPF hash, phone hash, and virtual line hash."
    }
  }
}
