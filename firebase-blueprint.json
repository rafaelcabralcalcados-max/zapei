      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "virtualLine": { "type": "string", "minLength": 10, "maxLength": 24 },
        "recoveryEmail": { "type": "string", "minLength": 5, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "virtualLine", "recoveryEmail", "createdAt"]
    },
    "UserDevice": {
      "title": "UserDevice",
      "description": "Authorized device linked to a Zapei user account (primary or secondary).",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
