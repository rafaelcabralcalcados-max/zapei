        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "receiverId", "candidate", "createdAt"]
    },
    "CpfRegistry": {
      "title": "CpfRegistry",
      "description": "LGPD-safe SHA-256 CPF registry enforcing strictly one Virtual Line per CPF.",
