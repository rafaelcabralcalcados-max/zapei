rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true) ||
        ('phone_number' in request.auth.token && request.auth.token.phone_number != null) ||
        ('firebase' in request.auth.token && request.auth.token.firebase.sign_in_provider == 'password')
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 260 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSha256(hash) {
      return hash is string && hash.size() == 64 && hash.matches('^[a-f0-9]{64}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && 'email' in request.auth.token
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['rafaelcabralrobo@gmail.com', 'suporte.chatfi@gmail.com'];
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // --- Validation Blueprints ---
    function isValidUserPublic(data) {
      return data.keys().hasAll(['uid', 'displayName', 'initials', 'commercialMode', 'hasStorefront', 'subscriptionStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'initials', 'statusMessage', 'avatarColor', 'avatarUrl',
          'commercialMode', 'manufacturerActivated', 'resellerActivated',
          'hasStorefront', 'storefrontName', 'storefrontPrivacy', 'factoryName', 'asaasWalletId', 'anchorDiscountPercent',
          'deliveryPolicyType', 'deliveryPolicyValue', 'deliveryPolicyPickup', 'deliveryPolicyLabel',
          'subscriptionStatus', 'trialEndsAt', 'virtualLine', 'authMethod', 'cpfVerified',
          'ratingAverage', 'ratingCount', 'lastRatingReviewId',
          'commercialBanned', 'commercialBanReason', 'commercialBanAtMs',
          'isOnline', 'lastSeenAt', 'showOnlineStatus', 'showLastSeen',
          'resellerReleasePreference', 'resellerReleaseNote', 'defaultCarrierDeadlineDays',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.initials is string && data.initials.size() >= 1 && data.initials.size() <= 4
        && (!('statusMessage' in data) || (data.statusMessage is string && data.statusMessage.size() <= 160))
        && (!('avatarColor' in data) || (data.avatarColor is string && data.avatarColor.size() <= 20))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 450000))
        && data.commercialMode in ['buyer', 'manufacturer', 'reseller']
        && (!('manufacturerActivated' in data) || data.manufacturerActivated is bool)
        && (!('resellerActivated' in data) || data.resellerActivated is bool)
        && data.hasStorefront is bool
        && (!('storefrontName' in data) || (data.storefrontName is string && data.storefrontName.size() <= 80))
        && (!('storefrontPrivacy' in data) || data.storefrontPrivacy in ['open', 'approved'])
        && (!('factoryName' in data) || (data.factoryName is string && data.factoryName.size() <= 80))
        && (!('asaasWalletId' in data) || (data.asaasWalletId is string && data.asaasWalletId.size() <= 128))
        && (!('anchorDiscountPercent' in data) || (data.anchorDiscountPercent is number && data.anchorDiscountPercent >= 0 && data.anchorDiscountPercent <= 80))
        && (!('deliveryPolicyType' in data) || data.deliveryPolicyType in ['boxes', 'pieces', 'amount'])
        && (!('deliveryPolicyValue' in data) || (data.deliveryPolicyValue is number && data.deliveryPolicyValue >= 0))
        && (!('deliveryPolicyPickup' in data) || data.deliveryPolicyPickup is bool)
        && (!('deliveryPolicyLabel' in data) || (data.deliveryPolicyLabel is string && data.deliveryPolicyLabel.size() <= 160))
        && data.subscriptionStatus in ['free', 'trial', 'active', 'expired']
        && (!('trialEndsAt' in data) || (data.trialEndsAt is number && data.trialEndsAt >= 0))
        && (!('virtualLine' in data) || (data.virtualLine is string && data.virtualLine.size() <= 24))
        && (!('authMethod' in data) || data.authMethod in ['phone', 'cpf'])
        && (!('cpfVerified' in data) || data.cpfVerified is bool)
        && (!('ratingAverage' in data) || (data.ratingAverage is number && data.ratingAverage >= 0 && data.ratingAverage <= 5))
        && (!('ratingCount' in data) || (data.ratingCount is number && data.ratingCount >= 0 && data.ratingCount <= 1000000))
        && (!('lastRatingReviewId' in data) || isValidId(data.lastRatingReviewId))
        && (!('commercialBanned' in data) || data.commercialBanned is bool)
        && (!('commercialBanReason' in data) || (data.commercialBanReason is string && data.commercialBanReason.size() <= 240))
        && (!('commercialBanAtMs' in data) || (data.commercialBanAtMs is number && data.commercialBanAtMs >= 0))
        && (!('isOnline' in data) || data.isOnline is bool)
        && (!('lastSeenAt' in data) || (data.lastSeenAt is number && data.lastSeenAt >= 0))
        && (!('showOnlineStatus' in data) || data.showOnlineStatus is bool)
        && (!('showLastSeen' in data) || data.showLastSeen is bool)
        && (!('resellerReleasePreference' in data) || data.resellerReleasePreference in ['after_account_release', 'upon_carrier_receipt', 'after_delivery_confirmation'])
        && (!('resellerReleaseNote' in data) || (data.resellerReleaseNote is string && data.resellerReleaseNote.size() <= 240))
        && (!('defaultCarrierDeadlineDays' in data) || (data.defaultCarrierDeadlineDays is number && data.defaultCarrierDeadlineDays >= 1 && data.defaultCarrierDeadlineDays <= 180))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['ownerId', 'phone', 'phoneHash', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'phone', 'phoneHash', 'cpfHash', 'virtualLine', 'authMethod',
          'email', 'deliveryAddress', 'favoriteGrades', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 32
        && data.phoneHash is string && data.phoneHash.size() >= 16 && data.phoneHash.size() <= 128
        && (!('cpfHash' in data) || isValidSha256(data.cpfHash))
        && (!('virtualLine' in data) || (data.virtualLine is string && data.virtualLine.size() <= 24))
        && (!('authMethod' in data) || data.authMethod in ['phone', 'cpf'])
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('deliveryAddress' in data) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 300))
        && (!('favoriteGrades' in data) || (data.favoriteGrades is list && data.favoriteGrades.size() <= 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserContact(data) {
      return data.keys().hasAll(['ownerId', 'name', 'phone', 'phoneHash', 'matchedHasStorefront', 'invited', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'name', 'phone', 'phoneHash', 'matchedUid', 'matchedRole',
          'matchedHasStorefront', 'matchedStorefrontName', 'matchedDeliveryPolicyLabel',
          'avatarColor', 'invited', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 32
        && data.phoneHash is string && data.phoneHash.size() >= 16 && data.phoneHash.size() <= 128
        && (!('matchedUid' in data) || (data.matchedUid is string && data.matchedUid.size() <= 128))
        && (!('matchedRole' in data) || data.matchedRole in ['normal', 'reseller', 'manufacturer'])
        && data.matchedHasStorefront is bool
        && (!('matchedStorefrontName' in data) || (data.matchedStorefrontName is string && data.matchedStorefrontName.size() <= 80))
        && (!('matchedDeliveryPolicyLabel' in data) || (data.matchedDeliveryPolicyLabel is string && data.matchedDeliveryPolicyLabel.size() <= 160))
        && (!('avatarColor' in data) || (data.avatarColor is string && data.avatarColor.size() <= 20))
        && data.invited is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPhoneIndex(data) {
      return data.keys().hasAll(['ownerId', 'displayName', 'initials', 'role', 'hasStorefront', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'displayName', 'initials', 'avatarColor', 'avatarUrl', 'role', 'hasStorefront',
          'storefrontName', 'deliveryPolicyType', 'deliveryPolicyValue',
          'deliveryPolicyPickup', 'deliveryPolicyLabel',
          'ratingAverage', 'ratingCount', 'commercialBanned', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.initials is string && data.initials.size() >= 1 && data.initials.size() <= 4
        && (!('avatarColor' in data) || (data.avatarColor is string && data.avatarColor.size() <= 20))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 450000))
        && data.role in ['normal', 'reseller', 'manufacturer']
        && data.hasStorefront is bool
        && (!('storefrontName' in data) || (data.storefrontName is string && data.storefrontName.size() <= 80))
        && (!('deliveryPolicyType' in data) || data.deliveryPolicyType in ['boxes', 'pieces', 'amount'])
        && (!('deliveryPolicyValue' in data) || (data.deliveryPolicyValue is number && data.deliveryPolicyValue >= 0))
        && (!('deliveryPolicyPickup' in data) || data.deliveryPolicyPickup is bool)
        && (!('deliveryPolicyLabel' in data) || (data.deliveryPolicyLabel is string && data.deliveryPolicyLabel.size() <= 160))
        && (!('ratingAverage' in data) || (data.ratingAverage is number && data.ratingAverage >= 0 && data.ratingAverage <= 5))
        && (!('ratingCount' in data) || (data.ratingCount is number && data.ratingCount >= 0 && data.ratingCount <= 1000000))
        && (!('commercialBanned' in data) || data.commercialBanned is bool)
        && data.updatedAt is timestamp;
    }

    function isValidPublicDirectoryEntry(data) {
      return data.keys().hasAll(['uid', 'displayName', 'displayNameLower', 'initials', 'role', 'hasStorefront', 'isDiscoverable', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'displayNameLower', 'initials', 'statusMessage',
          'avatarColor', 'avatarUrl', 'role', 'hasStorefront', 'storefrontName',
          'deliveryPolicyLabel', 'virtualLine', 'isDiscoverable',
          'ratingAverage', 'ratingCount', 'lastRatingReviewId', 'commercialBanned',
          'isOnline', 'lastSeenAt', 'showOnlineStatus', 'showLastSeen', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.displayNameLower is string && data.displayNameLower.size() >= 1 && data.displayNameLower.size() <= 80
        && data.initials is string && data.initials.size() >= 1 && data.initials.size() <= 4
        && (!('statusMessage' in data) || (data.statusMessage is string && data.statusMessage.size() <= 160))
        && (!('avatarColor' in data) || (data.avatarColor is string && data.avatarColor.size() <= 20))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 450000))
        && data.role in ['normal', 'reseller', 'manufacturer']
        && data.hasStorefront is bool
        && (!('storefrontName' in data) || (data.storefrontName is string && data.storefrontName.size() <= 80))
        && (!('deliveryPolicyLabel' in data) || (data.deliveryPolicyLabel is string && data.deliveryPolicyLabel.size() <= 160))
        && (!('virtualLine' in data) || (data.virtualLine is string && data.virtualLine.size() <= 24))
        && data.isDiscoverable is bool
        && (!('ratingAverage' in data) || (data.ratingAverage is number && data.ratingAverage >= 0 && data.ratingAverage <= 5))
        && (!('ratingCount' in data) || (data.ratingCount is number && data.ratingCount >= 0 && data.ratingCount <= 1000000))
        && (!('lastRatingReviewId' in data) || isValidId(data.lastRatingReviewId))
        && (!('commercialBanned' in data) || data.commercialBanned is bool)
        && (!('isOnline' in data) || data.isOnline is bool)
        && (!('lastSeenAt' in data) || (data.lastSeenAt is number && data.lastSeenAt >= 0))
        && (!('showOnlineStatus' in data) || data.showOnlineStatus is bool)
        && (!('showLastSeen' in data) || data.showLastSeen is bool)
        && data.updatedAt is timestamp;
    }

    function isValidConnection(data) {
      return data.keys().hasAll(['resellerId', 'factoryId', 'factoryName', 'reviewPhotos', 'paused', 'margins', 'approvedProductIds', 'rejectedProductIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'resellerId', 'resellerName', 'resellerStorefrontName',
          'factoryId', 'factoryName', 'approvalStatus',
          'deliveryPolicyType', 'deliveryPolicyValue', 'deliveryPolicyPickup', 'deliveryPolicyLabel',
          'reviewPhotos', 'paused', 'margins', 'approvedProductIds', 'rejectedProductIds',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.resellerId)
        && (!('resellerName' in data) || (data.resellerName is string && data.resellerName.size() <= 80))
        && (!('resellerStorefrontName' in data) || (data.resellerStorefrontName is string && data.resellerStorefrontName.size() <= 80))
        && isValidId(data.factoryId)
        && data.factoryName is string && data.factoryName.size() >= 1 && data.factoryName.size() <= 100
        && (!('approvalStatus' in data) || data.approvalStatus in ['pending', 'approved', 'rejected'])
        && (!('deliveryPolicyType' in data) || data.deliveryPolicyType in ['boxes', 'pieces', 'amount'])
        && (!('deliveryPolicyValue' in data) || (data.deliveryPolicyValue is number && data.deliveryPolicyValue >= 0))
        && (!('deliveryPolicyPickup' in data) || data.deliveryPolicyPickup is bool)
        && (!('deliveryPolicyLabel' in data) || (data.deliveryPolicyLabel is string && data.deliveryPolicyLabel.size() <= 160))
        && data.reviewPhotos is bool
        && data.paused is bool
        && data.margins is map
        && data.approvedProductIds is list && data.approvedProductIds.size() <= 500
        && data.rejectedProductIds is list && data.rejectedProductIds.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['factoryId', 'factoryName', 'name', 'category', 'factoryPrice', 'stockBoxes', 'gradeRaw', 'imageUrl', 'isSoldOutToday', 'moderationStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'factoryId', 'factoryName', 'name', 'sku', 'category', 'subcategory',
          'unitType', 'quantityPerPack', 'packLabel', 'specsSummary',
          'factoryPrice', 'stockBoxes', 'gradeRaw', 'imageUrl', 'imageUrls',
          'isSoldOutToday', 'moderationStatus', 'lastStockOrderId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.factoryId)
        && data.factoryName is string && data.factoryName.size() >= 1 && data.factoryName.size() <= 100
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && (!('sku' in data) || (data.sku is string && data.sku.size() <= 40))
        && data.category in [
          'Calçados & Acessórios', 'Moda Íntima & Lingerie', 'Vestuário & Confecção',
          'Automóveis & Veículos', 'Imóveis & Casas', 'Eletrônicos & Celulares',
          'Casa, Móveis & Decoração', 'Beleza, Perfumaria & Saúde',
          'Ferramentas, Construção & Agro', 'Alimentos, Bebidas & Outros',
          'Calçados', 'Bolsas', 'Sapatos', 'Joias', 'Acessórios'
        ]
        && (!('subcategory' in data) || (data.subcategory is string && data.subcategory.size() <= 60))
        && (!('unitType' in data) || data.unitType in ['par', 'unidade', 'kit'])
        && (!('quantityPerPack' in data) || (data.quantityPerPack is number && data.quantityPerPack >= 1 && data.quantityPerPack <= 10000))
        && (!('packLabel' in data) || (data.packLabel is string && data.packLabel.size() <= 30))
        && (!('specsSummary' in data) || (data.specsSummary is string && data.specsSummary.size() <= 240))
        && data.factoryPrice is number && data.factoryPrice >= 0 && data.factoryPrice <= 100000000
        && data.stockBoxes is number && data.stockBoxes >= 0 && data.stockBoxes <= 100000
        && data.gradeRaw is string && data.gradeRaw.size() >= 1 && data.gradeRaw.size() <= 200
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 350000
        && (!('imageUrls' in data) || (
          data.imageUrls is list
          && data.imageUrls.size() >= 1
          && data.imageUrls.size() <= 3
          && data.imageUrls[0] is string && data.imageUrls[0].size() >= 1 && data.imageUrls[0].size() <= 350000
          && (data.imageUrls.size() < 2 || (data.imageUrls[1] is string && data.imageUrls[1].size() >= 1 && data.imageUrls[1].size() <= 240000))
          && (data.imageUrls.size() < 3 || (data.imageUrls[2] is string && data.imageUrls[2].size() >= 1 && data.imageUrls[2].size() <= 240000))
        ))
        && data.isSoldOutToday is bool
        && data.moderationStatus in ['approved', 'flagged']
        && (!('lastStockOrderId' in data) || isValidId(data.lastStockOrderId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderCode', 'buyerId', 'buyerName', 'resellerId', 'storefrontName', 'factoryIds', 'status', 'discountMode', 'discountValue', 'discountAmount', 'buyerSubtotal', 'buyerFinalTotal', 'factoryCostTotal', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'orderCode', 'buyerId', 'buyerName', 'resellerId', 'storefrontName', 'factoryIds',
          'status', 'discountMode', 'discountValue', 'discountAmount',
          'buyerSubtotal', 'buyerFinalTotal', 'factoryCostTotal',
          'paymentMethod', 'installments', 'buyerChargedTotal', 'gatewayFee',
          'platformFeeGross', 'platformFeeNet', 'minimumFeeApplied',
          'splitFactoryNet', 'splitResellerNet',
          'asaasChargeId', 'asaasChargeStatus', 'asaasInvoiceUrl', 'asaasPixPayload',
          'createdAtMs', 'stockReserved', 'stockRestored', 'reservationExpiresAtMs',
          'cancelledAtMs', 'cancelReason', 'cancelledByUid',
          'resellerReleasePreference', 'resellerReleaseNote', 'buyerReleaseOption',
          'mutualAwarenessConfirmed', 'resellerShareReleaseStatus',
          'resellerShareReleasedAtMs', 'resellerShareReleasedByUid',
          'orderAgreementHistory',
          'createdAt', 'updatedAt'
        ])
        && data.orderCode is string && data.orderCode.size() >= 2 && data.orderCode.size() <= 32
        && isValidId(data.buyerId)
        && data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 80
        && isValidId(data.resellerId)
        && data.storefrontName is string && data.storefrontName.size() >= 1 && data.storefrontName.size() <= 80
        && data.factoryIds is list && data.factoryIds.size() >= 1 && data.factoryIds.size() <= 10 && data.factoryIds[0] is string
        && data.status in ['pending_inquiry', 'checking_stock', 'partial_confirmed', 'confirmed', 'logistics_sent', 'dispatched', 'completed', 'cancelled']
        && data.discountMode in ['fixed', 'percent']
        && data.discountValue is number && data.discountValue >= 0
        && data.discountAmount is number && data.discountAmount >= 0
        && data.buyerSubtotal is number && data.buyerSubtotal >= 0
        && data.buyerFinalTotal is number && data.buyerFinalTotal >= 0
        && data.factoryCostTotal is number && data.factoryCostTotal >= 0
        && (!('paymentMethod' in data) || data.paymentMethod in ['pix', 'credit_card'])
        && (!('installments' in data) || (data.installments is number && data.installments >= 1 && data.installments <= 12))
        && (!('buyerChargedTotal' in data) || (data.buyerChargedTotal is number && data.buyerChargedTotal >= 0))
        && (!('gatewayFee' in data) || (data.gatewayFee is number && data.gatewayFee >= 0))
        && (!('platformFeeGross' in data) || (data.platformFeeGross is number && data.platformFeeGross >= 0))
        && (!('platformFeeNet' in data) || (data.platformFeeNet is number && data.platformFeeNet >= 0))
        && (!('minimumFeeApplied' in data) || data.minimumFeeApplied is bool)
        && (!('splitFactoryNet' in data) || (data.splitFactoryNet is number && data.splitFactoryNet >= 0))
        && (!('splitResellerNet' in data) || (data.splitResellerNet is number && data.splitResellerNet >= 0))
        && (!('asaasChargeId' in data) || (data.asaasChargeId is string && data.asaasChargeId.size() <= 128))
        && (!('asaasChargeStatus' in data) || (data.asaasChargeStatus is string && data.asaasChargeStatus.size() <= 40))
        && (!('asaasInvoiceUrl' in data) || (data.asaasInvoiceUrl is string && data.asaasInvoiceUrl.size() <= 500))
        && (!('asaasPixPayload' in data) || (data.asaasPixPayload is string && data.asaasPixPayload.size() <= 1000))
        && (!('createdAtMs' in data) || (data.createdAtMs is number && data.createdAtMs >= 0))
        && (!('stockReserved' in data) || data.stockReserved is bool)
        && (!('stockRestored' in data) || data.stockRestored is bool)
        && (!('reservationExpiresAtMs' in data) || (data.reservationExpiresAtMs is number && data.reservationExpiresAtMs >= 0))
        && (!('cancelledAtMs' in data) || (data.cancelledAtMs is number && data.cancelledAtMs >= 0))
        && (!('cancelReason' in data) || (data.cancelReason is string && data.cancelReason.size() <= 80))
        && (!('cancelledByUid' in data) || isValidId(data.cancelledByUid))
        && (!('resellerReleasePreference' in data) || data.resellerReleasePreference in ['after_account_release', 'upon_carrier_receipt', 'after_delivery_confirmation'])
        && (!('resellerReleaseNote' in data) || (data.resellerReleaseNote is string && data.resellerReleaseNote.size() <= 240))
        && (!('buyerReleaseOption' in data) || data.buyerReleaseOption in ['upon_carrier_receipt', 'upon_product_in_hand'])
        && (!('mutualAwarenessConfirmed' in data) || data.mutualAwarenessConfirmed is bool)
        && (!('resellerShareReleaseStatus' in data) || data.resellerShareReleaseStatus in ['awaiting_payment', 'held', 'released_on_receipt', 'released_on_delivery'])
        && (!('resellerShareReleasedAtMs' in data) || (data.resellerShareReleasedAtMs is number && data.resellerShareReleasedAtMs >= 0))
        && (!('resellerShareReleasedByUid' in data) || isValidId(data.resellerShareReleasedByUid))
        && (!('orderAgreementHistory' in data) || (data.orderAgreementHistory is list && data.orderAgreementHistory.size() <= 30 && (data.orderAgreementHistory.size() == 0 || data.orderAgreementHistory[0] is map)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubOrder(data) {
      return data.keys().hasAll(['parentOrderId', 'subOrderCode', 'factoryId', 'factoryName', 'resellerId', 'buyerId', 'anonymousGroupLabel', 'items', 'status', 'factoryCost', 'buyerSubtotal', 'logisticsType', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'parentOrderId', 'subOrderCode', 'factoryId', 'factoryName', 'resellerId', 'buyerId',
          'anonymousGroupLabel', 'deliveryPolicyLabel', 'items', 'status',
          'factoryCost', 'buyerSubtotal', 'logisticsType', 'logisticsCompany',
          'logisticsAddress', 'receiptNote', 'receiptUrl', 'receiptAttached',
          'carrierDeadlineDays', 'carrierDeadlineAtMs', 'carrierDeadlineExtensions', 'carrierLastExtendedAtMs',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.parentOrderId)
        && data.subOrderCode is string && data.subOrderCode.size() >= 2 && data.subOrderCode.size() <= 32
        && isValidId(data.factoryId)
        && data.factoryName is string && data.factoryName.size() >= 1 && data.factoryName.size() <= 100
        && isValidId(data.resellerId)
        && isValidId(data.buyerId)
        && data.anonymousGroupLabel is string && data.anonymousGroupLabel.size() >= 1 && data.anonymousGroupLabel.size() <= 40
        && (!('deliveryPolicyLabel' in data) || (data.deliveryPolicyLabel is string && data.deliveryPolicyLabel.size() <= 160))
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map
        && data.status in ['pending_inquiry', 'checking_stock', 'partial_confirmed', 'confirmed', 'logistics_sent', 'dispatched', 'completed', 'cancelled']
        && data.factoryCost is number && data.factoryCost >= 0
        && data.buyerSubtotal is number && data.buyerSubtotal >= 0
        && data.logisticsType in ['none', 'transportadora', 'distribuidora']
        && (!('logisticsCompany' in data) || (data.logisticsCompany is string && data.logisticsCompany.size() <= 120))
        && (!('logisticsAddress' in data) || (data.logisticsAddress is string && data.logisticsAddress.size() <= 300))
        && (!('receiptNote' in data) || (data.receiptNote is string && data.receiptNote.size() <= 240))
        && (!('receiptUrl' in data) || (data.receiptUrl is string && data.receiptUrl.size() <= 350000))
        && (!('receiptAttached' in data) || data.receiptAttached is bool)
        && (!('carrierDeadlineDays' in data) || (data.carrierDeadlineDays is number && data.carrierDeadlineDays >= 1 && data.carrierDeadlineDays <= 180))
        && (!('carrierDeadlineAtMs' in data) || (data.carrierDeadlineAtMs is number && data.carrierDeadlineAtMs >= 0))
        && (!('carrierDeadlineExtensions' in data) || (data.carrierDeadlineExtensions is number && data.carrierDeadlineExtensions >= 0 && data.carrierDeadlineExtensions <= 10))
        && (!('carrierLastExtendedAtMs' in data) || (data.carrierLastExtendedAtMs is number && data.carrierLastExtendedAtMs >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['orderId', 'orderCode', 'layer', 'ownerId', 'counterpartyId', 'counterpartyName', 'amount', 'method', 'status', 'dueDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'orderId', 'orderCode', 'subOrderCode', 'layer', 'ownerId', 'counterpartyId',
          'buyerId', 'counterpartyName', 'amount', 'costReference',
          'gatewayFee', 'platformFeeGross', 'platformFeeNet', 'netAmount',
          'asaasChargeId', 'asaasChargeStatus',
          'method', 'status', 'dueDate', 'lastReminderSent', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.orderId)
        && data.orderCode is string && data.orderCode.size() >= 2 && data.orderCode.size() <= 32
        && (!('subOrderCode' in data) || (data.subOrderCode is string && data.subOrderCode.size() <= 32))
        && data.layer in ['factory_reseller', 'reseller_buyer']
        && isValidId(data.ownerId)
        && isValidId(data.counterpartyId)
        && (!('buyerId' in data) || isValidId(data.buyerId))
        && data.counterpartyName is string && data.counterpartyName.size() >= 1 && data.counterpartyName.size() <= 100
        && data.amount is number && data.amount >= 0
        && (!('costReference' in data) || (data.costReference is number && data.costReference >= 0))
        && (!('gatewayFee' in data) || (data.gatewayFee is number && data.gatewayFee >= 0))
        && (!('platformFeeGross' in data) || (data.platformFeeGross is number && data.platformFeeGross >= 0))
        && (!('platformFeeNet' in data) || (data.platformFeeNet is number && data.platformFeeNet >= 0))
        && (!('netAmount' in data) || (data.netAmount is number && data.netAmount >= 0))
        && (!('asaasChargeId' in data) || (data.asaasChargeId is string && data.asaasChargeId.size() <= 128))
        && (!('asaasChargeStatus' in data) || (data.asaasChargeStatus is string && data.asaasChargeStatus.size() <= 40))
        && data.method in ['À vista', 'Cartão', 'Cheque', 'Notinha']
        && data.status in ['Aguardando', 'Parcial', 'Quitado', 'Em Atraso', 'Cancelado']
        && data.dueDate is string && data.dueDate.size() >= 4 && data.dueDate.size() <= 24
        && (!('lastReminderSent' in data) || (data.lastReminderSent is string && data.lastReminderSent.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChat(data) {
      return data.keys().hasAll(['userA', 'userB', 'userAName', 'userBName', 'lastMessage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userA', 'userB', 'userAName', 'userBName', 'lastMessage', 'lastSenderId', 'createdAt', 'updatedAt'])
        && isValidId(data.userA)
        && isValidId(data.userB)
        && data.userAName is string && data.userAName.size() >= 1 && data.userAName.size() <= 80
        && data.userBName is string && data.userBName.size() >= 1 && data.userBName.size() <= 80
        && data.lastMessage is string && data.lastMessage.size() <= 400
        && (!('lastSenderId' in data) || isValidId(data.lastSenderId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, chatId) {
      return data.keys().hasAll(['chatId', 'userA', 'userB', 'senderId', 'senderName', 'type', 'text', 'createdAt'])
        && data.keys().hasOnly([
          'chatId', 'userA', 'userB', 'senderId', 'senderName', 'type', 'text',
          'mediaUrl', 'audioDuration', 'videoDuration', 'mediaTransitPath',
          'mediaDelivered', 'mediaSizeBytes', 'mediaMimeType', 'mediaExpiresAtMs',
          'orderId', 'orderCode', 'orderSummary', 'orderTotal', 'orderStatusLabel',
          'deletedForAll', 'deletedAtMs', 'createdAt'
        ])
        && data.chatId == chatId
        && isValidId(data.userA)
        && isValidId(data.userB)
        && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.type in ['text', 'audio', 'image', 'video', 'order_card', 'billing_reminder']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 500000))
        && (!('audioDuration' in data) || (data.audioDuration is string && data.audioDuration.size() <= 16))
        && (!('videoDuration' in data) || (data.videoDuration is string && data.videoDuration.size() <= 16))
        && (!('mediaTransitPath' in data) || (data.mediaTransitPath is string && data.mediaTransitPath.size() <= 260))
        && (!('mediaDelivered' in data) || data.mediaDelivered is bool)
        && (!('mediaSizeBytes' in data) || (data.mediaSizeBytes is number && data.mediaSizeBytes >= 0 && data.mediaSizeBytes <= 26214400))
        && (!('mediaMimeType' in data) || (data.mediaMimeType is string && data.mediaMimeType.size() <= 80))
        && (!('mediaExpiresAtMs' in data) || (data.mediaExpiresAtMs is number && data.mediaExpiresAtMs >= 0))
        && (!('orderId' in data) || (data.orderId is string && data.orderId.size() <= 128))
        && (!('orderCode' in data) || (data.orderCode is string && data.orderCode.size() <= 32))
        && (!('orderSummary' in data) || (data.orderSummary is string && data.orderSummary.size() <= 240))
        && (!('orderTotal' in data) || (data.orderTotal is number && data.orderTotal >= 0))
        && (!('orderStatusLabel' in data) || (data.orderStatusLabel is string && data.orderStatusLabel.size() <= 120))
        && (!('deletedForAll' in data) || data.deletedForAll is bool)
        && (!('deletedAtMs' in data) || (data.deletedAtMs is number && data.deletedAtMs >= 0))
        && data.createdAt is timestamp;
    }

    function isValidCallSession(data) {
      return data.keys().hasAll(['callerId', 'callerName', 'calleeId', 'calleeName', 'callType', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'callerId', 'callerName', 'callerInitials', 'callerAvatarColor',
          'calleeId', 'calleeName', 'calleeInitials', 'calleeAvatarColor',
          'callType', 'status', 'offerSdp', 'answerSdp', 'durationLabel',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.callerId)
        && data.callerName is string && data.callerName.size() >= 1 && data.callerName.size() <= 80
        && (!('callerInitials' in data) || (data.callerInitials is string && data.callerInitials.size() <= 4))
        && (!('callerAvatarColor' in data) || (data.callerAvatarColor is string && data.callerAvatarColor.size() <= 20))
        && isValidId(data.calleeId)
        && data.calleeName is string && data.calleeName.size() >= 1 && data.calleeName.size() <= 80
        && (!('calleeInitials' in data) || (data.calleeInitials is string && data.calleeInitials.size() <= 4))
        && (!('calleeAvatarColor' in data) || (data.calleeAvatarColor is string && data.calleeAvatarColor.size() <= 20))
        && data.callType in ['audio', 'video']
        && data.status in ['ringing', 'active', 'ended', 'declined', 'missed']
        && (!('offerSdp' in data) || (data.offerSdp is string && data.offerSdp.size() <= 20000))
        && (!('answerSdp' in data) || (data.answerSdp is string && data.answerSdp.size() <= 20000))
        && (!('durationLabel' in data) || (data.durationLabel is string && data.durationLabel.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIceCandidate(data) {
      return data.keys().hasAll(['senderId', 'receiverId', 'candidate', 'createdAt'])
        && data.keys().hasOnly(['senderId', 'receiverId', 'candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt'])
        && isValidId(data.senderId)
        && isValidId(data.receiverId)
        && data.senderId == request.auth.uid
        && data.candidate is string && data.candidate.size() <= 2000
        && (!('sdpMid' in data) || (data.sdpMid is string && data.sdpMid.size() <= 64))
        && (!('sdpMLineIndex' in data) || data.sdpMLineIndex is number)
        && data.createdAt is timestamp;
    }

    function isValidCpfRegistry(data) {
      return data.keys().hasAll(['ownerId', 'virtualLine', 'recoveryEmail', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'virtualLine', 'recoveryEmail', 'createdAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.virtualLine is string && data.virtualLine.size() >= 10 && data.virtualLine.size() <= 24
        && data.recoveryEmail is string && data.recoveryEmail.size() >= 5 && data.recoveryEmail.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidUserDevice(data, deviceId) {
      return data.keys().hasAll(['ownerId', 'deviceId', 'deviceName', 'platform', 'primary', 'createdAt', 'lastActiveAt'])
        && data.keys().hasOnly([
          'ownerId', 'deviceId', 'deviceName', 'platform', 'primary',
          'authorizedByDeviceId', 'createdAt', 'lastActiveAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.deviceId)
        && data.deviceId == deviceId
        && data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 100
        && data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 60
        && data.primary is bool
        && (!('authorizedByDeviceId' in data) || (data.authorizedByDeviceId is string && data.authorizedByDeviceId.size() <= 128))
        && data.createdAt is timestamp
        && data.lastActiveAt is timestamp;
    }

    function isValidDeviceAuthRequest(data) {
      return data.keys().hasAll(['uid', 'requestToken', 'code6', 'deviceId', 'deviceName', 'platform', 'status', 'expiresAtMs', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'requestToken', 'code6', 'deviceId', 'deviceName', 'platform',
          'status', 'approvedByDeviceId', 'expiresAtMs', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.requestToken is string && data.requestToken.size() >= 16 && data.requestToken.size() <= 128
        && data.code6 is string && data.code6.size() == 6 && data.code6.matches('^[0-9]{6}$')
        && isValidId(data.deviceId)
        && data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 100
        && data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 60
        && data.status in ['pending', 'approved', 'rejected', 'expired']
        && (!('approvedByDeviceId' in data) || (data.approvedByDeviceId is string && data.approvedByDeviceId.size() <= 128))
        && data.expiresAtMs is number && data.expiresAtMs > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPushEndpointBlob(data) {
      return data.keys().hasAll(['ownerId', 'ciphertext', 'iv', 'authTag', 'deviceCount', 'updatedAtMs'])
        && data.keys().hasOnly(['ownerId', 'ciphertext', 'iv', 'authTag', 'deviceCount', 'updatedAtMs'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ciphertext is string && data.ciphertext.size() >= 1 && data.ciphertext.size() <= 32000
        && data.iv is string && data.iv.size() >= 12 && data.iv.size() <= 64
        && data.authTag is string && data.authTag.size() >= 16 && data.authTag.size() <= 64
        && data.deviceCount is number && data.deviceCount >= 0 && data.deviceCount <= 10
        && data.updatedAtMs is number && data.updatedAtMs > 0;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['ticketCode', 'userId', 'userName', 'userRole', 'reason', 'description', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ticketCode', 'userId', 'userName', 'userVirtualLine', 'userRole',
          'reason', 'orderId', 'orderCode', 'description', 'status', 'createdAt', 'updatedAt'
        ])
        && data.ticketCode is string && data.ticketCode.size() >= 4 && data.ticketCode.size() <= 24
        && isValidId(data.userId)
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80
        && (!('userVirtualLine' in data) || (data.userVirtualLine is string && data.userVirtualLine.size() <= 32))
        && data.userRole in ['buyer', 'reseller', 'manufacturer']
        && data.reason in [
          'Problema com Pagamento / Pix',
          'Dúvida sobre Pedido',
          'Configuração de Wallet ID Asaas',
          'Ocorrência de Entrega / Má-fé',
          'Recurso / Liberação Comercial',
          'Denúncia / Segurança',
          'Outros'
        ]
        && (!('orderId' in data) || (data.orderId is string && data.orderId.size() <= 128))
        && (!('orderCode' in data) || (data.orderCode is string && data.orderCode.size() <= 32))
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 2000
        && data.status in ['Aberto', 'Em análise', 'Resolvido']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCpfCommercialLink(data) {
      return data.keys().hasAll(['ownerId', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'virtualLine', 'authMethod', 'createdAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && (!('virtualLine' in data) || (data.virtualLine is string && data.virtualLine.size() <= 24))
        && (!('authMethod' in data) || data.authMethod in ['phone', 'cpf'])
        && data.createdAt is timestamp;
    }

    function isValidCommercialIdentityHashes(data) {
      return data.keys().hasAll(['uid', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'cpfHash', 'phoneHash', 'virtualLineHash', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && (!('cpfHash' in data) || isValidSha256(data.cpfHash))
        && (!('phoneHash' in data) || (data.phoneHash is string && data.phoneHash.size() >= 16 && data.phoneHash.size() <= 128))
        && (!('virtualLineHash' in data) || isValidSha256(data.virtualLineHash))
        && data.updatedAt is timestamp;
    }

    function isValidCommercialReview(data) {
      return data.keys().hasAll(['orderId', 'orderCode', 'reviewerId', 'reviewerName', 'reviewerRole', 'targetUid', 'targetName', 'targetRole', 'stars', 'comment', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'orderId', 'orderCode', 'subOrderId',
          'reviewerId', 'reviewerName', 'reviewerRole',
          'targetUid', 'targetName', 'targetRole',
          'stars', 'comment', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.orderId)
        && data.orderCode is string && data.orderCode.size() >= 2 && data.orderCode.size() <= 32
        && (!('subOrderId' in data) || (data.subOrderId is string && data.subOrderId.size() <= 128))
        && isValidId(data.reviewerId)
        && data.reviewerId == request.auth.uid
        && data.reviewerName is string && data.reviewerName.size() >= 1 && data.reviewerName.size() <= 80
        && data.reviewerRole in ['buyer', 'reseller']
        && isValidId(data.targetUid)
        && data.targetUid != data.reviewerId
        && data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 80
        && data.targetRole in ['manufacturer', 'reseller']
        && data.stars is int && data.stars >= 1 && data.stars <= 5
        && data.comment is string && data.comment.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDeliveryReport(data) {
      return data.keys().hasAll([
          'reportCode', 'orderId', 'orderCode',
          'reporterId', 'reporterName', 'reporterRole',
          'reportedUid', 'reportedName', 'reportedRole',
          'reason', 'description', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'reportCode', 'orderId', 'orderCode', 'subOrderId', 'subOrderCode',
          'ticketId', 'ticketCode',
          'reporterId', 'reporterName', 'reporterRole',
          'reportedUid', 'reportedName', 'reportedRole',
          'reason', 'description', 'status', 'resolvedByUid', 'resolutionNote',
          'createdAt', 'updatedAt'
        ])
        && data.reportCode is string && data.reportCode.size() >= 4 && data.reportCode.size() <= 24
        && isValidId(data.orderId)
        && data.orderCode is string && data.orderCode.size() >= 2 && data.orderCode.size() <= 32
        && (!('subOrderId' in data) || (data.subOrderId is string && data.subOrderId.size() <= 128))
        && (!('subOrderCode' in data) || (data.subOrderCode is string && data.subOrderCode.size() <= 32))
        && (!('ticketId' in data) || (data.ticketId is string && data.ticketId.size() <= 128))
        && (!('ticketCode' in data) || (data.ticketCode is string && data.ticketCode.size() <= 24))
        && isValidId(data.reporterId)
        && data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 80
        && data.reporterRole in ['buyer', 'reseller']
        && isValidId(data.reportedUid)
        && data.reportedUid != data.reporterId
        && data.reportedName is string && data.reportedName.size() >= 1 && data.reportedName.size() <= 80
        && data.reportedRole in ['manufacturer', 'reseller']
        && data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 120
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 2000
        && data.status in ['Aberto', 'Em análise', 'Banido', 'Improcedente', 'Resolvido']
        && (!('resolvedByUid' in data) || isValidId(data.resolvedByUid))
        && (!('resolutionNote' in data) || (data.resolutionNote is string && data.resolutionNote.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommercialBan(data, banKey) {
      return data.keys().hasAll(['banKey', 'identifierType', 'targetUid', 'targetName', 'status', 'reason', 'bannedByUid', 'bannedAtMs', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'banKey', 'identifierType', 'targetUid', 'targetName',
          'cpfHash', 'phoneHash', 'virtualLineHash',
          'status', 'reason', 'reportId', 'ticketId', 'orderCode',
          'bannedByUid', 'bannedAtMs', 'liftedAtMs', 'liftedByUid', 'liftNote',
          'createdAt', 'updatedAt'
        ])
        && data.banKey == banKey
        && data.identifierType in ['uid', 'cpf', 'phone', 'virtualLine']
        && isValidId(data.targetUid)
        && data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 80
        && (!('cpfHash' in data) || isValidSha256(data.cpfHash))
        && (!('phoneHash' in data) || (data.phoneHash is string && data.phoneHash.size() >= 16 && data.phoneHash.size() <= 128))
        && (!('virtualLineHash' in data) || isValidSha256(data.virtualLineHash))
        && data.status in ['active', 'lifted']
        && data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 240
        && (!('reportId' in data) || (data.reportId is string && data.reportId.size() <= 128))
        && (!('ticketId' in data) || (data.ticketId is string && data.ticketId.size() <= 128))
        && (!('orderCode' in data) || (data.orderCode is string && data.orderCode.size() <= 32))
        && isValidId(data.bannedByUid)
        && data.bannedAtMs is number && data.bannedAtMs >= 0
        && (!('liftedAtMs' in data) || (data.liftedAtMs is number && data.liftedAtMs >= 0))
        && (!('liftedByUid' in data) || isValidId(data.liftedByUid))
        && (!('liftNote' in data) || (data.liftNote is string && data.liftNote.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. Users (Public storefront / messenger profile; NO PII — all PII is strictly in /private/info)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId)
        && (userId == request.auth.uid || existing().commercialMode in ['buyer', 'manufacturer', 'reseller']);
      allow list: if isSignedIn()
        && (existing().uid == request.auth.uid || existing().commercialMode in ['buyer', 'manufacturer', 'reseller']);
      allow create: if isVerified() && isValidId(userId) && userId == request.auth.uid
        && isValidUserPublic(incoming())
        && incoming().uid == request.auth.uid
        && (!('commercialBanned' in incoming()) || incoming().commercialBanned == false || (incoming().commercialMode == 'buyer' && incoming().hasStorefront == false))
        && (incoming().commercialMode == 'buyer' || ('cpfVerified' in incoming() && incoming().cpfVerified == true))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Owner updates profile, commercial mode, or applies synced commercial ban
          (userId == request.auth.uid
            && (!('commercialBanned' in existing()) || existing().commercialBanned == false || (incoming().commercialBanned == true && incoming().commercialMode == 'buyer' && incoming().hasStorefront == false))
            && (!('commercialBanned' in incoming()) || incoming().commercialBanned == false || (incoming().commercialMode == 'buyer' && incoming().hasStorefront == false))
            && (incoming().commercialMode == 'buyer' || !('commercialMode' in incoming().diff(existing()).affectedKeys()) || ('cpfVerified' in incoming() && incoming().cpfVerified == true))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'initials', 'statusMessage', 'avatarColor', 'avatarUrl',
              'commercialMode', 'manufacturerActivated', 'resellerActivated',
              'hasStorefront', 'storefrontName', 'storefrontPrivacy', 'factoryName', 'asaasWalletId', 'anchorDiscountPercent',
              'deliveryPolicyType', 'deliveryPolicyValue', 'deliveryPolicyPickup', 'deliveryPolicyLabel',
              'subscriptionStatus', 'trialEndsAt', 'virtualLine', 'authMethod', 'cpfVerified',
              'commercialBanned', 'commercialBanReason', 'commercialBanAtMs',
              'isOnline', 'lastSeenAt', 'showOnlineStatus', 'showLastSeen',
              'resellerReleasePreference', 'resellerReleaseNote', 'defaultCarrierDeadlineDays',
              'updatedAt'
            ])) ||
          // Tier 2: Order-verified reviewer atomically updates star rating aggregate
          (incoming().diff(existing()).affectedKeys().hasOnly(['ratingAverage', 'ratingCount', 'lastRatingReviewId', 'updatedAt'])
            && 'lastRatingReviewId' in incoming()
            && existsAfter(/databases/$(database)/documents/reviews/$(incoming().lastRatingReviewId))
            && getAfter(/databases/$(database)/documents/reviews/$(incoming().lastRatingReviewId)).data.reviewerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/reviews/$(incoming().lastRatingReviewId)).data.targetUid == userId) ||
          // Tier 3: Support/Admin applies or lifts exclusive commercial ban
          (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'commercialBanned', 'commercialBanReason', 'commercialBanAtMs',
              'commercialMode', 'hasStorefront', 'updatedAt'
            ]))
        );
      allow delete: if false;

      // Owner-only Private PII Subcollection
      match /private/{privateId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(privateId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(privateId)
          && isValidUserPrivate(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(privateId)
          && isValidUserPrivate(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'phone', 'phoneHash', 'cpfHash', 'virtualLine', 'authMethod',
            'email', 'deliveryAddress', 'favoriteGrades', 'updatedAt'
          ]);
        allow delete: if false;
      }

      // Owner-only Synced Device Contacts Subcollection
      match /contacts/{contactId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(contactId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(contactId)
          && isValidUserContact(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(contactId)
          && isValidUserContact(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'phone', 'phoneHash', 'matchedUid', 'matchedRole',
            'matchedHasStorefront', 'matchedStorefrontName', 'matchedDeliveryPolicyLabel',
            'avatarColor', 'invited', 'updatedAt'
          ]);
        allow delete: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(contactId);
      }

      // Owner-only Connected Devices Subcollection (Primary + Linked Secondary Sessions)
      match /devices/{deviceId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(deviceId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(deviceId)
          && isValidUserDevice(incoming(), deviceId)
          && incoming().createdAt == request.time
          && incoming().lastActiveAt == request.time;
        allow update: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(deviceId)
          && isValidUserDevice(incoming(), deviceId)
          && incoming().ownerId == existing().ownerId
          && incoming().deviceId == existing().deviceId
          && incoming().createdAt == existing().createdAt
          && incoming().lastActiveAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['deviceName', 'platform', 'primary', 'lastActiveAt']);
        allow delete: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(deviceId);
      }
    }

    // 2. Hashed Phone Lookup Index (Exact-match GET only, zero list scraping)
    match /phone_index/{phoneHash} {
      allow get: if isSignedIn() && isValidId(phoneHash);
      allow list: if false;
      allow create: if isVerified() && isValidId(phoneHash)
        && isValidPhoneIndex(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(phoneHash)
        && isValidPhoneIndex(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'initials', 'avatarColor', 'avatarUrl', 'role', 'hasStorefront',
          'storefrontName', 'deliveryPolicyType', 'deliveryPolicyValue',
          'deliveryPolicyPickup', 'deliveryPolicyLabel',
          'ratingAverage', 'ratingCount', 'commercialBanned', 'updatedAt'
        ]);
      allow delete: if isVerified() && isValidId(phoneHash) && existing().ownerId == request.auth.uid;
    }

    // 2b. PII-Free Public Directory (Search Zapei users by name or storefront; ZERO phones/emails)
    match /public_directory/{userId} {
      allow get: if isSignedIn() && isValidId(userId)
        && (userId == request.auth.uid || existing().isDiscoverable == true);
      allow list: if isSignedIn() && existing().isDiscoverable == true;
      allow create: if isVerified() && isOwner(userId) && isValidId(userId)
        && isValidPublicDirectoryEntry(incoming())
        && incoming().uid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId)
        && isValidPublicDirectoryEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId)
            && (!('commercialBanned' in existing()) || existing().commercialBanned == false || (incoming().commercialBanned == true && incoming().hasStorefront == false && incoming().role == 'normal'))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'displayNameLower', 'initials', 'statusMessage',
              'avatarColor', 'avatarUrl', 'role', 'hasStorefront', 'storefrontName',
              'deliveryPolicyLabel', 'virtualLine', 'isDiscoverable',
              'commercialBanned',
              'isOnline', 'lastSeenAt', 'showOnlineStatus', 'showLastSeen', 'updatedAt'
            ])) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['ratingAverage', 'ratingCount', 'lastRatingReviewId', 'updatedAt'])
            && 'lastRatingReviewId' in incoming()
            && existsAfter(/databases/$(database)/documents/reviews/$(incoming().lastRatingReviewId))
            && getAfter(/databases/$(database)/documents/reviews/$(incoming().lastRatingReviewId)).data.reviewerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/reviews/$(incoming().lastRatingReviewId)).data.targetUid == userId) ||
          (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['commercialBanned', 'role', 'hasStorefront', 'updatedAt']))
        );
      allow delete: if isVerified() && isOwner(userId) && isValidId(userId);
    }

    // 2c. LGPD-Safe SHA-256 CPF Registry (1 Virtual Line per CPF; exact-match GET only, zero list scraping)
    match /cpf_registry/{cpfHash} {
      allow get: if isValidSha256(cpfHash);
      allow list: if false;
      allow create: if isVerified() && isValidSha256(cpfHash)
        && isValidCpfRegistry(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    // 2d. Real-Time Device Authorization Requests (QR Code + 6-Digit Approval Gate)
    match /auth_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId)
        && existing().uid == request.auth.uid;
      allow list: if isSignedIn()
        && existing().uid == request.auth.uid;
      allow create: if isVerified() && isValidId(requestId)
        && isValidDeviceAuthRequest(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(requestId)
        && isValidDeviceAuthRequest(incoming())
        && existing().uid == request.auth.uid
        && existing().status == 'pending'
        && incoming().uid == existing().uid
        && incoming().requestToken == existing().requestToken
        && incoming().code6 == existing().code6
        && incoming().deviceId == existing().deviceId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().status in ['approved', 'rejected', 'expired']
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedByDeviceId', 'updatedAt']);
      allow delete: if isVerified() && isValidId(requestId)
        && existing().uid == request.auth.uid;
    }

    // 2e. Encrypted Web Push Subscriptions (exact-match GET only for push dispatch; owner-only writes)
    match /push_endpoints/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if false;
      allow create: if isVerified() && isOwner(userId) && isValidId(userId)
        && isValidPushEndpointBlob(incoming());
      allow update: if isVerified() && isOwner(userId) && isValidId(userId)
        && isValidPushEndpointBlob(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().diff(existing()).affectedKeys().hasOnly(['ciphertext', 'iv', 'authTag', 'deviceCount', 'updatedAtMs']);
      allow delete: if isVerified() && isOwner(userId) && isValidId(userId);
    }

    // 3. Reseller-to-Factory Connections (Requires explicit manufacturer approval)
    match /connections/{connectionId} {
      allow get: if isSignedIn() && isValidId(connectionId)
        && (
          (resource == null && connectionId.matches('^conn_' + request.auth.uid + '_[a-zA-Z0-9_\\-]+$')) ||
          (resource != null && (
            existing().resellerId == request.auth.uid ||
            existing().factoryId == request.auth.uid ||
            existing().approvalStatus == 'approved'
          ))
        );
      allow list: if isSignedIn()
        && (
          existing().resellerId == request.auth.uid ||
          existing().factoryId == request.auth.uid ||
          existing().approvalStatus == 'approved'
        );
      allow create: if isVerified() && isValidId(connectionId)
        && isValidConnection(incoming())
        && incoming().resellerId == request.auth.uid
        && 'approvalStatus' in incoming()
        && incoming().approvalStatus == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(connectionId)
        && isValidConnection(incoming())
        && incoming().resellerId == existing().resellerId
        && incoming().factoryId == existing().factoryId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Reseller manages own margins, photo review, pause state, or re-requests after rejection (NEVER self-approves)
          (existing().resellerId == request.auth.uid
            && (
              (incoming().diff(existing()).affectedKeys().hasOnly([
                'reviewPhotos', 'paused', 'margins', 'approvedProductIds', 'rejectedProductIds',
                'deliveryPolicyType', 'deliveryPolicyValue', 'deliveryPolicyPickup', 'deliveryPolicyLabel',
                'resellerName', 'resellerStorefrontName', 'updatedAt'
              ])) ||
              (incoming().diff(existing()).affectedKeys().hasOnly([
                'approvalStatus', 'resellerName', 'resellerStorefrontName', 'updatedAt'
              ])
                && 'approvalStatus' in existing()
                && existing().approvalStatus == 'rejected'
                && 'approvalStatus' in incoming()
                && incoming().approvalStatus == 'pending')
            )) ||
          // Action 2: Manufacturer accepts, rejects, or revokes reseller authorization
          (existing().factoryId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['approvalStatus', 'paused', 'updatedAt'])
            && 'approvalStatus' in incoming()
            && incoming().approvalStatus in ['pending', 'approved', 'rejected']) ||
          // Action 3: Admin override
          (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['approvalStatus', 'paused', 'updatedAt']))
        );
      allow delete: if isVerified() && isValidId(connectionId)
        && (existing().resellerId == request.auth.uid || existing().factoryId == request.auth.uid || isAdmin());
    }

    // 4. Manufacturer Products
    match /products/{productId} {
      allow get: if isSignedIn() && isValidId(productId)
        && (existing().factoryId == request.auth.uid || existing().moderationStatus == 'approved');
      allow list: if isSignedIn()
        && (existing().factoryId == request.auth.uid || existing().moderationStatus == 'approved');
      allow create: if isVerified() && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().factoryId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().factoryId == existing().factoryId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Manufacturer updates own stock or product catalog fields
          (existing().factoryId == request.auth.uid
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['stockBoxes', 'isSoldOutToday', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'sku', 'category', 'subcategory', 'unitType', 'quantityPerPack', 'packLabel', 'specsSummary', 'factoryPrice', 'stockBoxes', 'gradeRaw', 'imageUrl', 'imageUrls', 'isSoldOutToday', 'moderationStatus', 'updatedAt'])
            )) ||
          // Action: Atomic stock reservation at checkout tied to newly created order
          (incoming().diff(existing()).affectedKeys().hasOnly(['stockBoxes', 'isSoldOutToday', 'lastStockOrderId', 'updatedAt'])
            && 'lastStockOrderId' in incoming()
            && incoming().stockBoxes < existing().stockBoxes
            && incoming().stockBoxes >= 0
            && getAfter(/databases/$(database)/documents/orders/$(incoming().lastStockOrderId)).data.buyerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/orders/$(incoming().lastStockOrderId)).data.stockReserved == true
            && getAfter(/databases/$(database)/documents/orders/$(incoming().lastStockOrderId)).data.createdAt == request.time) ||
          // Action: Atomic idempotent stock restoration on unpaid order cancellation or 2h reservation expiration
          (incoming().diff(existing()).affectedKeys().hasOnly(['stockBoxes', 'isSoldOutToday', 'lastStockOrderId', 'updatedAt'])
            && 'lastStockOrderId' in incoming()
            && incoming().stockBoxes >= existing().stockBoxes
            && incoming().stockBoxes <= existing().stockBoxes + 10000
            && exists(/databases/$(database)/documents/orders/$(incoming().lastStockOrderId))
            && (
              get(/databases/$(database)/documents/orders/$(incoming().lastStockOrderId)).data.buyerId == request.auth.uid ||
              get(/databases/$(database)/documents/orders/$(incoming().lastStockOrderId)).data.resellerId == request.auth.uid ||
              request.auth.uid in get(/databases/$(database)/documents/orders/$(incoming().lastStockOrderId)).data.factoryIds
            )
            && !(get(/databases/$(database)/documents/orders/$(incoming().lastStockOrderId)).data.status in ['dispatched', 'completed', 'cancelled'])
            && (!('stockRestored' in get(/databases/$(database)/documents/orders/$(incoming().lastStockOrderId)).data)
              || get(/databases/$(database)/documents/orders/$(incoming().lastStockOrderId)).data.stockRestored == false)
            && getAfter(/databases/$(database)/documents/orders/$(incoming().lastStockOrderId)).data.status == 'cancelled'
            && getAfter(/databases/$(database)/documents/orders/$(incoming().lastStockOrderId)).data.stockRestored == true
            && getAfter(/databases/$(database)/documents/orders/$(incoming().lastStockOrderId)).data.updatedAt == request.time)
        );
      allow delete: if isVerified() && isValidId(productId) && existing().factoryId == request.auth.uid;
    }

    // 5. Customer Mixed Orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId)
        && (existing().buyerId == request.auth.uid || existing().resellerId == request.auth.uid || request.auth.uid in existing().factoryIds);
      allow list: if isSignedIn()
        && (existing().buyerId == request.auth.uid || existing().resellerId == request.auth.uid || request.auth.uid in existing().factoryIds);
      allow create: if isVerified() && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().buyerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(orderId)
        && isValidOrder(incoming())
        && !(existing().status in ['completed', 'cancelled'])
        && incoming().orderCode == existing().orderCode
        && incoming().buyerId == existing().buyerId
        && incoming().resellerId == existing().resellerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Reseller forwards inquiry, updates release preference/history, applies commission-only discount, or attaches Asaas split charge
          (existing().resellerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'discountMode', 'discountValue', 'discountAmount',
              'buyerFinalTotal', 'buyerSubtotal', 'factoryCostTotal',
              'paymentMethod', 'installments', 'buyerChargedTotal', 'gatewayFee',
              'platformFeeGross', 'platformFeeNet', 'minimumFeeApplied',
              'splitFactoryNet', 'splitResellerNet', 'stockReserved',
              'asaasChargeId', 'asaasChargeStatus', 'asaasInvoiceUrl', 'asaasPixPayload',
              'resellerReleasePreference', 'resellerReleaseNote',
              'resellerShareReleaseStatus', 'orderAgreementHistory',
              'updatedAt'
            ])) ||
          // Action: Participating manufacturer recalculates totals after partial cut / dispatch or logs logistics deadline/receipt history
          (request.auth.uid in existing().factoryIds
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'buyerFinalTotal', 'buyerSubtotal', 'factoryCostTotal', 'discountAmount',
              'buyerChargedTotal', 'gatewayFee', 'platformFeeGross', 'platformFeeNet',
              'minimumFeeApplied', 'splitFactoryNet', 'splitResellerNet', 'stockReserved',
              'orderAgreementHistory', 'updatedAt'
            ])) ||
          // Action: Buyer records generated Asaas charge details, updates optional release choice, or releases reseller share
          (existing().buyerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'paymentMethod', 'installments', 'buyerChargedTotal', 'gatewayFee',
              'platformFeeGross', 'platformFeeNet', 'minimumFeeApplied',
              'splitFactoryNet', 'splitResellerNet',
              'asaasChargeId', 'asaasChargeStatus', 'asaasInvoiceUrl', 'asaasPixPayload',
              'buyerReleaseOption', 'mutualAwarenessConfirmed',
              'resellerShareReleaseStatus', 'resellerShareReleasedAtMs', 'resellerShareReleasedByUid',
              'orderAgreementHistory',
              'updatedAt'
            ])) ||
          // Action: Buyer confirms delivery on a dispatched order
          (existing().buyerId == request.auth.uid
            && existing().status == 'dispatched'
            && incoming().status == 'completed'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'resellerShareReleaseStatus', 'resellerShareReleasedAtMs',
              'resellerShareReleasedByUid', 'orderAgreementHistory', 'updatedAt'
            ])) ||
          // Action: Buyer, Reseller, or Participating Manufacturer cancels unpaid order and marks stockRestored atomically
          ((existing().buyerId == request.auth.uid
              || existing().resellerId == request.auth.uid
              || request.auth.uid in existing().factoryIds)
            && !(existing().status in ['dispatched', 'completed', 'cancelled'])
            && (!('stockRestored' in existing()) || existing().stockRestored == false)
            && incoming().status == 'cancelled'
            && incoming().stockRestored == true
            && (!('cancelledByUid' in incoming()) || incoming().cancelledByUid == request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'stockRestored', 'cancelledAtMs', 'cancelReason',
              'cancelledByUid', 'asaasChargeStatus', 'updatedAt'
            ]))
        );
      allow delete: if false;
    }

    // 6. Split Manufacturer Sub-Orders
    match /sub_orders/{subOrderId} {
      allow get: if isSignedIn() && isValidId(subOrderId)
        && (existing().factoryId == request.auth.uid
          || existing().resellerId == request.auth.uid
          || existing().buyerId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/orders/$(existing().parentOrderId)).data.factoryIds);
      allow list: if isSignedIn()
        && (existing().factoryId == request.auth.uid || existing().resellerId == request.auth.uid || existing().buyerId == request.auth.uid);
      allow create: if isVerified() && isValidId(subOrderId)
        && isValidSubOrder(incoming())
        && (incoming().buyerId == request.auth.uid || incoming().resellerId == request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (exists(/databases/$(database)/documents/orders/$(incoming().parentOrderId))
          || existsAfter(/databases/$(database)/documents/orders/$(incoming().parentOrderId)));
      allow update: if isVerified() && isValidId(subOrderId)
        && isValidSubOrder(incoming())
        && !(existing().status in ['completed', 'cancelled'])
        && incoming().parentOrderId == existing().parentOrderId
        && incoming().subOrderCode == existing().subOrderCode
        && incoming().factoryId == existing().factoryId
        && incoming().resellerId == existing().resellerId
        && incoming().buyerId == existing().buyerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Manufacturer confirms stock / partial cut / attaches dispatch receipt / updates carrier deadline
          (existing().factoryId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'items', 'status', 'factoryCost', 'buyerSubtotal', 'receiptNote', 'receiptUrl',
              'receiptAttached', 'carrierDeadlineDays', 'carrierDeadlineAtMs',
              'carrierDeadlineExtensions', 'carrierLastExtendedAtMs', 'updatedAt'
            ])) ||
          // Action: Reseller forwards inquiry or attaches post-confirmation logistics & carrier deadline
          (existing().resellerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'logisticsType', 'logisticsCompany', 'logisticsAddress',
              'carrierDeadlineDays', 'carrierDeadlineAtMs',
              'carrierDeadlineExtensions', 'carrierLastExtendedAtMs', 'updatedAt'
            ])) ||
          // Action: Atomic sub-order cancellation synced with parent order cancellation
          ((existing().buyerId == request.auth.uid
              || existing().resellerId == request.auth.uid
              || existing().factoryId == request.auth.uid
              || request.auth.uid in get(/databases/$(database)/documents/orders/$(existing().parentOrderId)).data.factoryIds)
            && !(existing().status in ['dispatched', 'completed', 'cancelled'])
            && incoming().status == 'cancelled'
            && getAfter(/databases/$(database)/documents/orders/$(existing().parentOrderId)).data.status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if false;
    }

    // 7. Dual Financial Layer Payments
    match /payments/{paymentId} {
      allow get: if isSignedIn() && isValidId(paymentId)
        && (existing().ownerId == request.auth.uid
          || existing().counterpartyId == request.auth.uid
          || ('buyerId' in existing() && existing().buyerId == request.auth.uid)
          || request.auth.uid in get(/databases/$(database)/documents/orders/$(existing().orderId)).data.factoryIds);
      allow list: if isSignedIn()
        && (existing().ownerId == request.auth.uid || existing().counterpartyId == request.auth.uid);
      allow create: if isVerified() && isValidId(paymentId)
        && isValidPayment(incoming())
        && (incoming().ownerId == request.auth.uid || incoming().counterpartyId == request.auth.uid || incoming().buyerId == request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(paymentId)
        && isValidPayment(incoming())
        && (existing().ownerId == request.auth.uid
          || existing().counterpartyId == request.auth.uid
          || ('buyerId' in existing() && existing().buyerId == request.auth.uid)
          || request.auth.uid in get(/databases/$(database)/documents/orders/$(existing().orderId)).data.factoryIds)
        && incoming().orderId == existing().orderId
        && incoming().layer == existing().layer
        && incoming().ownerId == existing().ownerId
        && incoming().counterpartyId == existing().counterpartyId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Owner updates payment method, status, amount, split/Asaas metadata, or sends billing reminder
          (existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'amount', 'costReference', 'gatewayFee', 'platformFeeGross', 'platformFeeNet',
              'netAmount', 'asaasChargeId', 'asaasChargeStatus', 'method', 'status',
              'lastReminderSent', 'updatedAt'
            ])) ||
          // Action: Counterparty recalculates amount on partial stock cut or links Asaas charge metadata
          (existing().counterpartyId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'amount', 'costReference', 'asaasChargeId', 'asaasChargeStatus', 'updatedAt'
            ])) ||
          // Action: Atomic cancellation synced with cancelled parent order
          (incoming().status == 'Cancelado'
            && getAfter(/databases/$(database)/documents/orders/$(existing().orderId)).data.status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'asaasChargeStatus', 'updatedAt'
            ]))
        );
      allow delete: if false;
    }

    // 8. Real 1-to-1 Messenger Chats & Messages (Master Gate)
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId)
        && (
          resource == null
            ? (chatId.matches('^' + request.auth.uid + '__.*') || chatId.matches('.*__' + request.auth.uid + '$'))
            : (existing().userA == request.auth.uid || existing().userB == request.auth.uid)
        );
      allow list: if isSignedIn()
        && (existing().userA == request.auth.uid || existing().userB == request.auth.uid);
      allow create: if isVerified() && isValidId(chatId)
        && isValidChat(incoming())
        && (incoming().userA == request.auth.uid || incoming().userB == request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(chatId)
        && isValidChat(incoming())
        && (existing().userA == request.auth.uid || existing().userB == request.auth.uid)
        && incoming().userA == existing().userA
        && incoming().userB == existing().userB
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSenderId', 'userAName', 'userBName', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(messageId)
          && (
            get(/databases/$(database)/documents/chats/$(chatId)).data.userA == request.auth.uid ||
            get(/databases/$(database)/documents/chats/$(chatId)).data.userB == request.auth.uid
          );
        allow list: if isSignedIn()
          && (existing().userA == request.auth.uid || existing().userB == request.auth.uid);
        allow create: if isVerified() && isValidId(chatId) && isValidId(messageId)
          && isValidChatMessage(incoming(), chatId)
          && incoming().senderId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && get(/databases/$(database)/documents/chats/$(chatId)).data.userA == incoming().userA
          && get(/databases/$(database)/documents/chats/$(chatId)).data.userB == incoming().userB
          && (incoming().userA == request.auth.uid || incoming().userB == request.auth.uid);
        allow update: if isVerified() && isValidId(chatId) && isValidId(messageId)
          && isValidChatMessage(incoming(), chatId)
          && (existing().userA == request.auth.uid || existing().userB == request.auth.uid)
          && (
            (existing().senderId != request.auth.uid
              && existing().mediaDelivered == false
              && incoming().mediaDelivered == true
              && incoming().chatId == existing().chatId
              && incoming().userA == existing().userA
              && incoming().userB == existing().userB
              && incoming().senderId == existing().senderId
              && incoming().senderName == existing().senderName
              && incoming().type == existing().type
              && incoming().text == existing().text
              && incoming().createdAt == existing().createdAt
              && incoming().diff(existing()).affectedKeys().hasOnly(['mediaDelivered', 'mediaUrl'])) ||
            (existing().senderId == request.auth.uid
              && (!('deletedForAll' in existing()) || existing().deletedForAll == false)
              && incoming().deletedForAll == true
              && incoming().chatId == existing().chatId
              && incoming().userA == existing().userA
              && incoming().userB == existing().userB
              && incoming().senderId == existing().senderId
              && incoming().senderName == existing().senderName
              && incoming().type == existing().type
              && incoming().text == 'Mensagem apagada'
              && incoming().createdAt == existing().createdAt
              && (!('mediaUrl' in incoming()) || incoming().mediaUrl == '')
              && incoming().diff(existing()).affectedKeys().hasOnly(['deletedForAll', 'deletedAtMs', 'text', 'mediaUrl', 'mediaTransitPath', 'audioDuration', 'videoDuration']))
          );
        allow delete: if false;
      }
    }

    // 9. Real WebRTC Audio & Video Call Sessions + ICE Signaling (Master Gate)
    match /calls/{callId} {
      allow get: if isSignedIn() && isValidId(callId)
        && (existing().callerId == request.auth.uid || existing().calleeId == request.auth.uid);
      allow list: if isSignedIn()
        && (existing().callerId == request.auth.uid || existing().calleeId == request.auth.uid);
      allow create: if isVerified() && isValidId(callId)
        && isValidCallSession(incoming())
        && incoming().callerId == request.auth.uid
        && incoming().status == 'ringing'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(callId)
        && isValidCallSession(incoming())
        && !(existing().status in ['ended', 'declined', 'missed'])
        && incoming().callerId == existing().callerId
        && incoming().calleeId == existing().calleeId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Callee answers or declines
          (existing().calleeId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'answerSdp', 'durationLabel', 'updatedAt'])) ||
          // Action: Caller hangs up or cancels ringing
          (existing().callerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'durationLabel', 'updatedAt']))
        );
      allow delete: if isVerified() && isValidId(callId)
        && (existing().callerId == request.auth.uid || existing().calleeId == request.auth.uid);

      match /callerCandidates/{candidateId} {
        allow get: if isSignedIn() && isValidId(callId) && isValidId(candidateId)
          && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid);
        allow list: if isSignedIn()
          && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid);
        allow create: if isVerified() && isValidId(callId) && isValidId(candidateId)
          && isValidIceCandidate(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/calls/$(callId))
          && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == incoming().receiverId;
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow get: if isSignedIn() && isValidId(callId) && isValidId(candidateId)
          && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid);
        allow list: if isSignedIn()
          && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid);
        allow create: if isVerified() && isValidId(callId) && isValidId(candidateId)
          && isValidIceCandidate(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/calls/$(callId))
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid
          && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == incoming().receiverId;
        allow update, delete: if false;
      }
    }

    // 10. Help & Support Center Tickets
    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId)
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(ticketId)
        && isValidSupportTicket(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'Aberto'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(ticketId)
        && isValidSupportTicket(incoming())
        && (isAdmin() || existing().status != 'Resolvido')
        && incoming().ticketCode == existing().ticketCode
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Admin triages support ticket status
          (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          // Action: Ticket creator marks their own ticket as resolved
          (existing().userId == request.auth.uid
            && incoming().status == 'Resolvido'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if false;
    }

    // 11. SHA-256 CPF Commercial Verification Binding (Exact-match GET only, no listing)
    match /cpf_commercial_links/{cpfHash} {
      allow get: if isSignedIn() && isValidSha256(cpfHash);
      allow list: if false;
      allow create: if isVerified() && isValidSha256(cpfHash)
        && isValidCpfCommercialLink(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 12. Non-PII SHA-256 Identity Hashes (Cross-identifier ban lookup by Admin / Owner)
    match /commercial_identity_hashes/{userId} {
      allow get: if isSignedIn() && isValidId(userId)
        && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && isOwner(userId) && isValidId(userId)
        && isValidCommercialIdentityHashes(incoming())
        && incoming().uid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isOwner(userId) && isValidId(userId)
        && isValidCommercialIdentityHashes(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['cpfHash', 'phoneHash', 'virtualLineHash', 'updatedAt']);
      allow delete: if false;
    }

    // 13. Order-Verified Star Reviews for Manufacturers and Resellers
    match /reviews/{reviewId} {
      allow get: if isSignedIn() && isValidId(reviewId);
      allow list: if isSignedIn()
        && (existing().targetUid is string || existing().reviewerId == request.auth.uid);
      allow create: if isVerified() && isValidId(reviewId)
        && isValidCommercialReview(incoming())
        && reviewId == incoming().orderId + '_' + request.auth.uid + '_' + incoming().targetUid + '_' + incoming().targetRole
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/orders/$(incoming().orderId))
        && (
          get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.status in ['dispatched', 'completed']
          || ('subOrderId' in incoming()
            && incoming().subOrderId.size() > 0
            && exists(/databases/$(database)/documents/sub_orders/$(incoming().subOrderId))
            && get(/databases/$(database)/documents/sub_orders/$(incoming().subOrderId)).data.parentOrderId == incoming().orderId
            && get(/databases/$(database)/documents/sub_orders/$(incoming().subOrderId)).data.status in ['dispatched', 'completed'])
        )
        && (
          (incoming().reviewerRole == 'buyer'
            && get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.buyerId == request.auth.uid
            && incoming().targetUid == get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.resellerId) ||
          (incoming().reviewerRole == 'reseller'
            && get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.resellerId == request.auth.uid
            && incoming().targetRole == 'manufacturer'
            && incoming().targetUid in get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.factoryIds)
        );
      allow update: if isVerified() && isValidId(reviewId)
        && isValidCommercialReview(incoming())
        && existing().reviewerId == request.auth.uid
        && incoming().orderId == existing().orderId
        && incoming().orderCode == existing().orderCode
        && incoming().reviewerId == existing().reviewerId
        && incoming().reviewerRole == existing().reviewerRole
        && incoming().targetUid == existing().targetUid
        && incoming().targetRole == existing().targetRole
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['stars', 'comment', 'reviewerName', 'targetName', 'updatedAt']);
      allow delete: if false;
    }

    // 14. Delivery Bad-Faith / Non-Fulfillment Reports
    match /delivery_reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId)
        && (existing().reporterId == request.auth.uid || existing().reportedUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (existing().reporterId == request.auth.uid || existing().reportedUid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(reportId)
        && isValidDeliveryReport(incoming())
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'Aberto'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/orders/$(incoming().orderId))
        && (
          (incoming().reporterRole == 'buyer'
            && get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.buyerId == request.auth.uid
            && incoming().reportedUid == get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.resellerId) ||
          (incoming().reporterRole == 'reseller'
            && get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.resellerId == request.auth.uid
            && incoming().reportedRole == 'manufacturer'
            && incoming().reportedUid in get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.factoryIds)
        );
      allow update: if isVerified() && isValidId(reportId)
        && isAdmin()
        && isValidDeliveryReport(incoming())
        && incoming().reportCode == existing().reportCode
        && incoming().orderId == existing().orderId
        && incoming().reporterId == existing().reporterId
        && incoming().reportedUid == existing().reportedUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolvedByUid', 'resolutionNote', 'updatedAt']);
      allow delete: if false;
    }

    // 15. Exclusive Commercial Role Bans (Indexed by UID, CPF hash, phone hash, virtual line hash)
    match /commercial_bans/{banKey} {
      allow get: if isSignedIn() && isValidId(banKey);
      allow list: if isAdmin();
      allow create: if isVerified() && isAdmin() && isValidId(banKey)
        && isValidCommercialBan(incoming(), banKey)
        && incoming().bannedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isAdmin() && isValidId(banKey)
        && isValidCommercialBan(incoming(), banKey)
        && incoming().banKey == existing().banKey
        && incoming().identifierType == existing().identifierType
        && incoming().targetUid == existing().targetUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'reason', 'reportId', 'ticketId', 'orderCode',
          'bannedByUid', 'bannedAtMs', 'liftedAtMs', 'liftedByUid', 'liftNote', 'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
